{
  "manifest_version": 3,
  "name": "ProScreen — Screen Annotation Studio",
  "short_name": "ProScreen",
  "version": "1.0.2",
  "description": "Professional browser screen annotation toolkit for teachers, developers, presenters, and video creators.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProScreen Annotation Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "tabCapture",
    "desktopCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-toolbar": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Show or hide the ProScreen annotation toolbar on the active tab"
    },
    "toggle-ghost-mode": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Toggle Ghost Mode (hide toolbar while keeping hotkeys active)"
    },
    "capture-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture annotated screenshot of the current tab"
    },
    "clear-annotations": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Clear all annotations on the current tab"
    },
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop screen recording"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "options.html", "offscreen.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
